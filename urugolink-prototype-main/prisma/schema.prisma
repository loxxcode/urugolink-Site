generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { CUSTOMER LANDLORD ADMIN }
enum ListingType { RENT SALE }
enum ListingStatus { DRAFT PENDING APPROVED REJECTED RENTED SOLD ARCHIVED }
enum InquiryStatus { NEW IN_PROGRESS CLOSED }
enum BookingStatus { REQUESTED CONFIRMED CANCELLED COMPLETED }
enum OfferStatus { PENDING ACCEPTED REJECTED WITHDRAWN }
enum PaymentStatus { PENDING PAID FAILED REFUNDED }

model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  phone        String?
  passwordHash String
  role         UserRole   @default(CUSTOMER)
  isVerified   Boolean    @default(false)
  isActive     Boolean    @default(true)
  properties   Property[] @relation("PropertyOwner")
  inquiries    Inquiry[]
  bookings     Booking[]
  offers       Offer[]
  messages     Message[]  @relation("MessageSender")
  reviews      Review[]
  contracts    Contract[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model PropertyType {
  id         String     @id @default(cuid())
  name       String     @unique
  properties Property[]
}

model Location {
  id        String     @id @default(cuid())
  province  String
  district  String
  sector    String?
  address   String?
  latitude  Float?
  longitude Float?
  properties Property[]
  @@index([district, province])
}

model Property {
  id           String         @id @default(cuid())
  ownerId      String
  typeId       String
  locationId   String
  title        String
  description  String
  priceRwf     Decimal        @db.Decimal(14, 2)
  listingType  ListingType
  status       ListingStatus  @default(PENDING)
  bedrooms     Int?
  bathrooms    Int?
  areaSqm      Float?
  furnished    Boolean        @default(false)
  owner        User           @relation("PropertyOwner", fields: [ownerId], references: [id])
  type         PropertyType   @relation(fields: [typeId], references: [id])
  location     Location       @relation(fields: [locationId], references: [id])
  images       PropertyImage[]
  inquiries    Inquiry[]
  bookings     Booking[]
  offers       Offer[]
  reviews      Review[]
  contracts    Contract[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  @@index([listingType, status, priceRwf])
  @@index([ownerId])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  isCover    Boolean  @default(false)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Inquiry {
  id         String        @id @default(cuid())
  propertyId String
  customerId String
  message    String
  status     InquiryStatus @default(NEW)
  property   Property      @relation(fields: [propertyId], references: [id])
  customer   User          @relation(fields: [customerId], references: [id])
  messages   Message[]
  createdAt  DateTime      @default(now())
}

model Message {
  id        String   @id @default(cuid())
  inquiryId String
  senderId  String
  body      String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  sender    User     @relation("MessageSender", fields: [senderId], references: [id])
  createdAt DateTime @default(now())
}

model Booking {
  id          String        @id @default(cuid())
  propertyId  String
  customerId  String
  visitAt     DateTime
  status      BookingStatus @default(REQUESTED)
  property    Property      @relation(fields: [propertyId], references: [id])
  customer    User          @relation(fields: [customerId], references: [id])
  createdAt   DateTime      @default(now())
}

model Offer {
  id         String      @id @default(cuid())
  propertyId String
  customerId String
  amountRwf  Decimal     @db.Decimal(14, 2)
  message    String?
  status     OfferStatus @default(PENDING)
  property   Property    @relation(fields: [propertyId], references: [id])
  customer   User        @relation(fields: [customerId], references: [id])
  createdAt  DateTime    @default(now())
}

model Contract {
  id         String    @id @default(cuid())
  propertyId String
  customerId String
  kind       ListingType
  startDate  DateTime?
  endDate    DateTime?
  status     String    @default("DRAFT")
  property   Property  @relation(fields: [propertyId], references: [id])
  customer   User      @relation(fields: [customerId], references: [id])
  payments   Payment[]
  createdAt  DateTime  @default(now())
}

model Payment {
  id          String        @id @default(cuid())
  contractId  String
  amountRwf   Decimal       @db.Decimal(14, 2)
  provider    String?
  providerRef String?       @unique
  status      PaymentStatus @default(PENDING)
  contract    Contract      @relation(fields: [contractId], references: [id])
  createdAt   DateTime      @default(now())
}

model Review {
  id         String   @id @default(cuid())
  propertyId String
  customerId String
  rating     Int
  comment    String?
  property   Property @relation(fields: [propertyId], references: [id])
  customer   User     @relation(fields: [customerId], references: [id])
  createdAt  DateTime @default(now())
  @@unique([propertyId, customerId])
}
